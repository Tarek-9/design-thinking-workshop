# create .env file with random password before starting
DB_PASSWORD=

# optional: leave empty to log emails instead of sending them (see backend/README.md)
RESEND_API_KEY=
RESEND_FROM=

# one initial password per seeded staff account: five distinct values, only read
# the first time each account is created (see backend/README.md)
STAFF_1_PASSWORD=
STAFF_2_PASSWORD=
STAFF_3_PASSWORD=
STAFF_4_PASSWORD=
STAFF_5_PASSWORD=

# the demo week of Applications is seeded by default; set this to an
# empty value for a stack that starts with no Applications at all
# SPRING_PROFILES_ACTIVE=demo

# HTTP basic auth for the form and the dashboard, one credential for both. Empty
# means open (local demo); after setting both, run docker compose up -d --build.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# The demo runs at localhost:8081 (form) and localhost:8082 (dashboard). The
# sign-in cookie is Secure, so serve it through TLS. Keep demo data synthetic.
